#include <inttypes.h>
#include <stdio.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <assert.h>
#include <errno.h>
#include "spiffs.h"
_Static_assert(SPIFFS_READ_ONLY==0,"private synthetic filesystem writable; no device");
_Static_assert(SPIFFS_OBJ_META_LEN==4,"meta4");
_Static_assert(CONFIG_SPIFFS_PAGE_SIZE==512,"page512");
_Static_assert(SPIFFS_USE_MAGIC&&SPIFFS_USE_MAGIC_LENGTH,"magic+length");
#if SPIFFS_NO_BLIND_WRITES
#error "Do not change production no-blind-write setting for this reproduction"
#endif
#define N 0x6e0000
static unsigned char image[N];static uint64_t reads,writes,erases,set_bits;
static int depth;
void spiffs_api_lock(struct spiffs_t*fs){(void)fs;assert(!depth++);}
void spiffs_api_unlock(struct spiffs_t*fs){(void)fs;assert(depth==1);depth--;}
static s32_t hal_read(spiffs*fs,u32_t addr,u32_t n,u8_t*out){(void)fs;assert(addr<=N&&n<=N-addr);reads++;memcpy(out,image+addr,n);return SPIFFS_OK;}
static s32_t hal_write(spiffs*fs,u32_t addr,u32_t n,u8_t*in){(void)fs;assert(addr<=N&&n<=N-addr);writes++;for(size_t i=0;i<n;i++){if(in[i]&~image[addr+i])set_bits++;image[addr+i]&=in[i];}return SPIFFS_OK;}
static s32_t hal_erase(spiffs*fs,u32_t addr,u32_t n){(void)fs;assert(addr<=N&&n<=N-addr);erases++;memset(image+addr,255,n);return SPIFFS_OK;}
static unsigned char work[1024],fds[8192],cache[8192];
static void config(spiffs*fs,spiffs_config*c){memset(fs,0,sizeof(*fs));memset(c,0,sizeof(*c));c->hal_read_f=hal_read;c->hal_write_f=hal_write;c->hal_erase_f=hal_erase;c->phys_size=N;c->phys_addr=0;c->phys_erase_block=4096;c->log_block_size=4096;c->log_page_size=512;}
static void mount_new(spiffs*fs,spiffs_config*c){config(fs,c);int r=SPIFFS_mount(fs,c,work,fds,sizeof(fds),cache,sizeof(cache),NULL);assert(!r&&SPIFFS_mounted(fs));}
static void format_new(spiffs*fs,spiffs_config*c){memset(image,255,sizeof(image));config(fs,c);int r=SPIFFS_mount(fs,c,work,fds,sizeof(fds),cache,sizeof(cache),NULL);assert(r!=0);assert(!SPIFFS_format(fs));mount_new(fs,c);}

#include "cJSON.h"
#define PET_P4_COMMIT_LEAN_IO 1
#define PET_P4_MINIAPP_CATALOG_MAX 32
#define PET_P4_MINIAPP_WIDGET_ID_MAX 48
#define MINIAPP_CATALOG_VERSION 3
#define MINIAPP_CATALOG_JSON_MAX 16384
#define PET_WIDGET_TRACE_SCOPE(name,...) int name __attribute__((unused))=0
#define pet_widget_trace_scope_end(name) ((void)(name))
#define vTaskDelay(ticks) ((void)(ticks))
#define pdMS_TO_TICKS(ms) (ms)
#define MINIAPP_CATALOG_CHECK_KEY "\"check\":\""
static bool owner_current=true,g_catalog_recovery_blocked;
static char g_storage_failure[128];
static bool storage_work_current(void){return owner_current;}
static spiffs *live_fs;static int fault;
static unsigned opened,wrote,closed,verified,max_verify_read,zero_truncates;
typedef struct {spiffs_file fd;bool used,writing;int error;} MemFile;
static MemFile files[8];
static MemFile*s_open(const char*p,const char*mode){
 assert(!strcmp(p,"/spiffs/p4-miniapps-1.json"));opened++;
 bool writing=strcmp(mode,"rb")!=0;
 if(fault==1&&!strcmp(mode,"r+b")){errno=EACCES;return NULL;}
 if(fault==8&&!writing){errno=EIO;return NULL;}
 spiffs_flags flags=!strcmp(mode,"r+b")?SPIFFS_O_RDWR:!strcmp(mode,"wb")?(SPIFFS_O_WRONLY|SPIFFS_O_CREAT|SPIFFS_O_TRUNC):SPIFFS_O_RDONLY;
 int fd=SPIFFS_open(live_fs,p+7,flags,0);
 if(fd<0){errno=SPIFFS_errno(live_fs)==SPIFFS_ERR_NOT_FOUND?ENOENT:EIO;SPIFFS_clearerr(live_fs);return NULL;}
 if(fault==2&&!strcmp(mode,"wb")){assert(SPIFFS_close(live_fs,fd)>=0);errno=EIO;return NULL;} /* create happened, open failed */
 for(unsigned i=0;i<8;i++)if(!files[i].used){files[i]=(MemFile){.fd=fd,.used=true,.writing=writing};return &files[i];}
 abort();
}
static size_t s_write(const void*p,size_t size,size_t count,MemFile*f){assert(f->used&&f->writing&&size==1);wrote++;size_t n=fault==4?count/2:count;int r=SPIFFS_write(live_fs,f->fd,(void*)p,(int)n);if(r<0){f->error=1;return 0;}return (size_t)r;}
static int s_flush(MemFile*f){(void)f;if(fault==5){errno=EIO;return EOF;}return 0;} /* stdio drained by s_write, no extra fsync */
static int s_truncate(int fd,off_t n){if(!n){zero_truncates++;if(fault==3){errno=EIO;return -1;}}else if(fault==6){errno=EIO;return -1;}int r=SPIFFS_ftruncate(live_fs,fd,(u32_t)n);return r<0?-1:0;}
static int s_seek(MemFile*f,long offset,int whence){if(fault==14&&!f->writing)return -1;int mode=whence==SEEK_SET?SPIFFS_SEEK_SET:whence==SEEK_CUR?SPIFFS_SEEK_CUR:SPIFFS_SEEK_END;return SPIFFS_lseek(live_fs,f->fd,(s32_t)offset,mode)<0?-1:0;}
static long s_tell(MemFile*f){return SPIFFS_lseek(live_fs,f->fd,0,SPIFFS_SEEK_CUR);}
static size_t s_read(void*p,size_t size,size_t count,MemFile*f){assert(f->used&&!f->writing&&size==1);verified++;if(count>max_verify_read)max_verify_read=(unsigned)count;size_t n=fault==9?count/2:count;int r=SPIFFS_read(live_fs,f->fd,p,(int)n);if(r<0){f->error=1;return 0;}if(fault==10&&r)((unsigned char*)p)[0]^=1;return (size_t)r;}
static int s_error(MemFile*f){return f->error||(fault==11&&!f->writing);}
static int s_getc(MemFile*f){if(fault==12)return 'X';unsigned char b;int r=SPIFFS_read(live_fs,f->fd,&b,1);if(r<0)f->error=1;return r>0?b:EOF;}
static int s_close(MemFile*f){assert(f->used);bool writing=f->writing;int r=SPIFFS_close(live_fs,f->fd);f->used=false;closed++;if(fault==15&&writing)owner_current=false;if((fault==7&&writing)||(fault==13&&!writing)){errno=EIO;return EOF;}return r<0?EOF:0;}
#define FILE MemFile
#define fopen s_open
#define fwrite s_write
#define fflush s_flush
#define fclose s_close
#define fread s_read
#define ferror s_error
#define fgetc s_getc
#define fileno(f) ((f)->fd)
#define ftruncate s_truncate
#define fseek s_seek
#define ftell s_tell
#include "pet_p4_file_read.h"
/* ACTUAL_CATALOG_SOURCE */

#undef FILE
#undef fopen
#undef fwrite
#undef fflush
#undef fclose
#undef fread
#undef ferror
#undef fgetc
#undef fileno
#undef ftruncate
#undef fseek
#undef ftell
static void put_sdk(spiffs*fs,const char*path,const unsigned char*data,unsigned n){int fd=SPIFFS_open(fs,path,SPIFFS_O_CREAT|SPIFFS_O_TRUNC|SPIFFS_O_RDWR,0);assert(fd>=0);assert(SPIFFS_write(fs,fd,(void*)data,n)==(int)n);assert(SPIFFS_close(fs,fd)>=0);}
static size_t get_sdk(spiffs*fs,const char*path,unsigned char*out,unsigned cap){int fd=SPIFFS_open(fs,path,SPIFFS_O_RDONLY,0);if(fd<0){SPIFFS_clearerr(fs);return 0;}int n=SPIFFS_read(fs,fd,out,cap);assert(n>=0&&SPIFFS_close(fs,fd)>=0);return (size_t)n;}
static bool fail_json;
static void*json_allocate(size_t n){return fail_json?NULL:malloc(n);}
static void json_release(void*p){free(p);}
int main(int argc,char**argv){
 assert(argc==3);int mode=atoi(argv[2]);FILE*f=fopen(argv[1],"rb");assert(f);char target[16384];size_t len=fread(target,1,sizeof(target)-1,f);assert(len==5625&&!ferror(f)&&feof(f)&&!fclose(f));target[len]=0;
 cJSON*root=cJSON_Parse(target);assert(root);const cJSON*array=cJSON_GetObjectItemCaseSensitive(root,"items");assert(cJSON_GetArraySize(array)==32);
 miniapp_catalog_item_t items[32]={0};for(unsigned i=0;i<32;i++){const cJSON*x=cJSON_GetArrayItem(array,(int)i);snprintf(items[i].widget_id,48,"%s",cJSON_GetObjectItemCaseSensitive(x,"widgetId")->valuestring);snprintf(items[i].title,64,"%s",cJSON_GetObjectItemCaseSensitive(x,"title")->valuestring);items[i].slot=(uint8_t)cJSON_GetObjectItemCaseSensitive(x,"slot")->valueint;items[i].package_generation=(uint8_t)cJSON_GetObjectItemCaseSensitive(x,"packageGeneration")->valueint;items[i].widget_checksum=(uint32_t)strtoul(cJSON_GetObjectItemCaseSensitive(x,"widgetChecksum")->valuestring,NULL,16);items[i].buttons_checksum=(uint32_t)strtoul(cJSON_GetObjectItemCaseSensitive(x,"buttonsChecksum")->valuestring,NULL,16);items[i].sprites_checksum=(uint32_t)strtoul(cJSON_GetObjectItemCaseSensitive(x,"spritesChecksum")->valuestring,NULL,16);}
 const char*active=cJSON_GetObjectItemCaseSensitive(root,"activeWidgetId")->valuestring;const char*cursor=cJSON_GetObjectItemCaseSensitive(root,"selectedWidgetId")->valuestring;bool seed=cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(root,"seedPending"));
 for(int fc=0;fc<=16;fc++){
  spiffs fs;spiffs_config cfg;format_new(&fs,&cfg);live_fs=&fs;fault=0;owner_current=true;g_catalog_recovery_blocked=false;memset(files,0,sizeof(files));
  unsigned char old[5625],original[64],out[16384];memset(old,0x33,sizeof(old));memset(original,0x5a,sizeof(original));put_sdk(&fs,"/p4-miniapps-0.json",original,sizeof(original));put_sdk(&fs,"/p4-miniapps-1.json",old,sizeof(old));
  /* Actual SDK pathological partial truncate, leaving page10's beyond-EOF tail. */
  int fd=SPIFFS_open(&fs,"/p4-miniapps-1.json",SPIFFS_O_RDWR,0);assert(fd>=0);assert(SPIFFS_ftruncate(&fs,fd,5253)>=0&&SPIFFS_close(&fs,fd)>=0);
  if(fc==2)assert(SPIFFS_remove(&fs,"/p4-miniapps-1.json")>=0);
  fault=fc;opened=wrote=closed=verified=max_verify_read=zero_truncates=0;fail_json=fc==16;cJSON_Hooks hooks={json_allocate,json_release};cJSON_InitHooks(&hooks);
  miniapp_catalog_commit_t commit={.generation=99,.sequence=999};bool ok=write_catalog_snapshot_at(items,32,active,cursor,seed,0,485,&commit);
  fail_json=false;cJSON_InitHooks(NULL);fault=0;owner_current=true;
  bool latched=g_catalog_recovery_blocked;unsigned seen=opened;
  if(latched){assert(!write_catalog_snapshot_at(items,32,active,cursor,seed,0,485,&commit));assert(opened==seen);}
  SPIFFS_unmount(&fs);mount_new(&fs,&cfg);size_t active_n=get_sdk(&fs,"/p4-miniapps-0.json",out,sizeof(out));assert(active_n==sizeof(original)&&!memcmp(original,out,active_n));
  size_t n=get_sdk(&fs,"/p4-miniapps-1.json",out,sizeof(out));unsigned diffs=0;if(n==len)for(unsigned i=0;i<n;i++)diffs+=out[i]!=(unsigned char)target[i];else diffs=99999;
  printf("{\"fault\":%d,\"ok\":%s,\"quarantine\":%s,\"commitSequence\":%u,\"activeGenerationUnchanged\":true,\"coldTargetDiffBytes\":%u,\"readbackCalls\":%u,\"maxReadbackChunk\":%u,\"zeroTruncates\":%u}\n",fc,ok?"true":"false",latched?"true":"false",commit.sequence,diffs,verified,max_verify_read,zero_truncates);fflush(stdout);
  if(mode==2){assert(ok&&!latched&&commit.sequence==486);assert(diffs==0);}
  if(mode==1){
   if(fc==0){assert(ok&&!latched&&commit.sequence==486&&diffs==0&&zero_truncates==1&&verified>0&&max_verify_read<=64);}
   else{assert(!ok&&commit.sequence==999);assert(latched==(fc!=1&&fc!=16));if(fc==1||fc==16)assert(!zero_truncates);}
  }else if(fc==0){assert(ok&&!latched&&diffs>0);break;} /* real old writer accepts corrupted result */
  SPIFFS_unmount(&fs);
 }
 cJSON_Delete(root);return 0;
}
