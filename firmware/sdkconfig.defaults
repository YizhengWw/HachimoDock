CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_SPIFFS_GC_MAX_RUNS=64
CONFIG_SPIFFS_PAGE_SIZE=512
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_ESP_H264_DECODER_IRAM=y
# The 640x480 profile has 30 coded macroblock rows and is safe for tinyh264's
# row-paired dual-task acceleration on ESP32-P4.
CONFIG_ESP_H264_DUAL_TASK=y
CONFIG_ESP_H264_DUAL_TASK_CORE=1
CONFIG_ESP_H264_DUAL_TASK_PRIORITY=17

CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Wi-Fi comes from the ESP32-C6 on the companion board through ESP-Hosted (SDIO slot 1, 4-bit).
# Defaults for ESP32-P4 are CMD19/CLK18/D0-D3=14-17 and C6 reset on GPIO54; the SD card uses slot 0
# on GPIO39-44, so the two never share pins. Keep the radio failures contained to the radio:
# a stuck co-processor must never restart the P4, which keeps serving USB.
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
CONFIG_ESP_HOSTED_CLI_ENABLED=n
CONFIG_ESP_HOSTED_MEM_MONITOR=n
CONFIG_ESP_HOSTED_ENABLE_ITWT=n
CONFIG_ESP_HOSTED_ENABLE_PEER_DATA_TRANSFER=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_IGMP=n
CONFIG_LWIP_MAX_SOCKETS=6
# Station-only client: the DHCP server (SoftAP), mDNS queries and ARP address-conflict probing add
# flash without serving this link.
CONFIG_LWIP_DHCPS=n
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=n
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=n
