{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
    "pats": {
      "type": "int",
      "init": 0
    },
    "left": {
      "type": "int",
      "init": 0
    },
    "plant": {
      "type": "int",
      "init": 0
    },
    "object": {
      "type": "int",
      "init": 0
    },
    "editing": {
      "type": "int",
      "init": 0
    }
  },
  "states": [
    "idle",
    "glad",
    "plant",
    "object",
    "place"
  ],
  "initial_state": "idle",
  "transitions": [
    {
      "from": "plant",
      "on": "primary",
      "inc": {
        "plant": 1
      }
    },
    {
      "from": "object",
      "on": "primary",
      "inc": {
        "object": 1
      }
    },
    {
      "from": "place",
      "on": "primary",
      "page": "next"
    },
    {
      "from": "*",
      "on": "primary",
      "to": "glad",
      "inc": {
        "pats": 1
      },
      "set": {
        "left": 3,
        "editing": 0
      }
    },
    {
      "from": "plant",
      "on": "secondary",
      "to": "object",
      "set": {
        "editing": 1
      }
    },
    {
      "from": "object",
      "on": "secondary",
      "to": "place",
      "set": {
        "editing": 1
      }
    },
    {
      "from": "place",
      "on": "secondary",
      "to": "idle",
      "set": {
        "editing": 0
      }
    },
    {
      "from": "*",
      "on": "secondary",
      "to": "plant",
      "set": {
        "editing": 1
      }
    },
    {
      "from": "*",
      "on": "finish",
      "to": "idle",
      "set": {
        "editing": 0
      }
    },
    {
      "from": "plant",
      "on": "previous",
      "inc": {
        "plant": -1
      },
      "set": {
        "editing": 1
      }
    },
    {
      "from": "plant",
      "on": "next",
      "inc": {
        "plant": 1
      },
      "set": {
        "editing": 1
      }
    },
    {
      "from": "object",
      "on": "previous",
      "inc": {
        "object": -1
      },
      "set": {
        "editing": 1
      }
    },
    {
      "from": "object",
      "on": "next",
      "inc": {
        "object": 1
      },
      "set": {
        "editing": 1
      }
    },
    {
      "from": "place",
      "on": "previous",
      "page": "prev"
    },
    {
      "from": "place",
      "on": "next",
      "page": "next"
    },
    {
      "from": "*",
      "on": "select.plant",
      "to": "plant",
      "set": {
        "editing": 1
      }
    },
    {
      "from": "*",
      "on": "select.object",
      "to": "object",
      "set": {
        "editing": 1
      }
    }
  ],
  "tick": [
    {
      "every_ms": 1000,
      "while_state": "glad",
      "inc": {
        "left": -1
      },
      "when": {
        "var": "left",
        "lte": 0
      },
      "then": {
        "to": "idle"
      }
    }
  ],
  "dashboard": {
    "title": "哈基米小屋",
    "visualStyle": "clean",
    "visualPalette": "sunset",
    "visualLayout": "tool",
    "visualSprite": "star",
    "eyebrow": {
      "switch_page": {
        "oak": "窗边相伴",
        "mint": "茶桌小景",
        "night": "左右相望"
      }
    },
    "headline": {
      "switch_state": {
        "idle": "今天，也一起慢慢来。",
        "glad": "摸摸收到啦，喜欢你。",
        "plant": "选一株喜欢的绿植。",
        "object": "给小屋添一件好物。",
        "place": "把喜欢的摆在身边。"
      }
    },
    "metricValue": {
      "var": "pats"
    },
    "note": "点选物件，左右换样式；布置自动保存。",
    "footer": "主键互动/更换  副键布置/完成  全局键退出",
    "metricLabel": {
      "switch_state": {
        "idle": "摸摸头",
        "glad": "再摸摸",
        "plant": "换一株",
        "object": "换一件",
        "place": "换个位置"
      }
    },
    "metricUnit": {
