{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
    "remaining_s": {
      "type": "int",
      "init": 1500
    },
    "phase_total_s": {
      "type": "int",
      "init": 1500
    },
    "completed_sessions": {
      "type": "int",
      "init": 0
    },
    "focus_s": {
      "type": "int",
      "init": 1500
    }
  },
  "states": [
    "focus",
    "focus_paused",
    "rest",
    "rest_paused",
    "ready"
  ],
  "initial_state": "ready",
  "transitions": [
    {
      "from": "focus",
      "on": "tomato.start_pause",
      "to": "focus_paused"
    },
    {
      "from": "focus_paused",
      "on": "tomato.start_pause",
      "to": "focus"
    },
    {
      "from": "rest",
      "on": "tomato.start_pause",
      "to": "rest_paused"
    },
    {
      "from": "rest_paused",
      "on": "tomato.start_pause",
      "to": "rest"
    },
    {
      "from": "focus",
      "on": "tomato.skip_phase",
      "to": "rest",
      "set": {
        "remaining_s": 300,
        "phase_total_s": 300
      }
    },
    {
      "from": "focus_paused",
      "on": "tomato.skip_phase",
      "to": "rest_paused",
      "set": {
        "remaining_s": 300,
        "phase_total_s": 300
      }
    },
    {
      "from": "rest",
      "on": "tomato.skip_phase",
      "to": "focus",
      "set": {
        "remaining_s": {
          "var": "focus_s"
        },
        "phase_total_s": {
          "var": "focus_s"
        }
      }
    },
    {
      "from": "rest_paused",
      "on": "tomato.skip_phase",
      "to": "focus_paused",
      "set": {
        "remaining_s": {
          "var": "focus_s"
        },
        "phase_total_s": {
          "var": "focus_s"
        }
      }
    },
    {
      "from": "focus",
      "on": "tomato.reset_phase",
      "to": "focus",
      "set": {
        "remaining_s": {
          "var": "focus_s"
        },
        "phase_total_s": {
          "var": "focus_s"
        }
      }
    },
    {
      "from": "focus_paused",
      "on": "tomato.reset_phase",
      "to": "focus_paused",
      "set": {
        "remaining_s": {
          "var": "focus_s"
        },
        "phase_total_s": {
          "var": "focus_s"
        }
      }
    },
    {
      "from": "rest",
      "on": "tomato.reset_phase",
      "to": "rest",
      "set": {
        "remaining_s": 300,
        "phase_total_s": 300
      }
    },
    {
      "from": "rest_paused",
      "on": "tomato.reset_phase",
      "to": "rest_paused",
      "set": {
        "remaining_s": 300,
        "phase_total_s": 300
      }
    },
    {
      "from": "ready",
      "on": "tomato.start_pause",
      "to": "focus",
      "set": {
        "remaining_s": {
          "var": "focus_s"
        },
        "phase_total_s": {
          "var": "focus_s"
        }
      }
    },
    {
      "from": "ready",
      "on": "tomato.shorter",
      "inc": {
        "focus_s": -300
      }
    },
    {
      "from": "ready",
      "on": "tomato.longer",
      "inc": {
        "focus_s": 300
      }
    }
  ],
  "tick": [
    {
      "every_ms": 1000,
      "while_state": "focus",
      "inc": {
        "remaining_s": -1
      },
      "when": {
        "var": "remaining_s",
        "lte": 0
      },
      "then": {
        "to": "rest",
        "set": {
          "remaining_s": 300,
          "phase_total_s": 300
        },
        "inc": {
          "completed_sessions": 1
        }
      }
    },
    {
      "every_ms": 1000,
      "while_state": "rest",
      "inc": {
        "remaining_s": -1
      },
      "when": {
        "var": "remaining_s",
        "lte": 0
      },
      "then": {
        "to": "focus",
        "set": {
          "remaining_s": {
            "var": "focus_s"
          },
          "phase_total_s": {
            "var": "focus_s"
          }
        }
      }
    }
  ],
  "dashboard": {
    "title": "番茄钟",
    "eyebrow": {
      "switch_state": {
        "focus": "专注阶段",
        "focus_paused": "专注已暂停",
        "rest": "休息阶段",
        "rest_paused": "休息已暂停",
        "ready": "准备开始"
      }
    },
    "headline": {
      "switch_state": {
        "focus": "把这一刻，留给专注。",
        "focus_paused": "歇一歇，稍后继续。",
        "rest": "做完一轮，放松一下。",
        "rest_paused": "休息计时已暂停。",
        "ready": "选好时长，再开始。"
      }
    },
    "metricLabel": "剩余时间",
    "metricValue": {
      "switch_state": {
        "focus": {
          "fmt_mmss": "remaining_s"
        },
        "focus_paused": {
          "fmt_mmss": "remaining_s"
        },
        "rest": {
          "fmt_mmss": "remaining_s"
        },
        "rest_paused": {
          "fmt_mmss": "remaining_s"
        },
        "ready": {
          "fmt_mmss": "focus_s"
        }
      }
    },
    "metricUnit": {
      "switch_state": {
        "focus": "暂停专注",
        "focus_paused": "继续专注",
        "rest": "暂停休息",
        "rest_paused": "继续休息",
        "ready": "开始专注"
      }
    },
    "badge": {
      "var": "completed_sessions"
    },
    "note": "开始前可调 5–60 分钟 · 休息 5 分钟",
    "footer": "主键开始/暂停  副键跳过  全局键退出",
    "progress": {
      "pct_of": "remaining_s",
      "of_max": "phase_total_s",
      "label": "本轮剩余"
    },
    "visualStyle": "clean",
    "visualPalette": "sunset",
    "visualLayout": "tool",
    "visualSprite": "timer"
  },
