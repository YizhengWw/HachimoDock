{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
    "score": {
      "type": "int",
      "init": 0
    },
    "best": {
      "type": "int",
      "init": 0
    }
  },
  "states": [
    "ready",
    "playing",
    "result",
    "paused"
  ],
  "initial_state": "ready",
  "transitions": [
    {
      "from": "ready",
      "on": "blocks.start",
      "to": "playing",
      "set": {
        "score": 0
      }
    },
    {
      "from": "result",
      "on": "blocks.start",
      "to": "playing",
      "set": {
        "score": 0
      }
    },
    {
      "from": "playing",
      "on": "blocks.left"
    },
    {
      "from": "playing",
      "on": "blocks.right"
    },
    {
      "from": "playing",
      "on": "blocks.rotate"
    },
    {
      "from": "playing",
      "on": "blocks.drop"
    },
    {
      "from": "playing",
      "on": "session.pause",
      "to": "paused"
    },
    {
      "from": "paused",
      "on": "session.pause",
      "to": "playing"
    },
    {
      "from": "paused",
      "on": "blocks.start",
      "to": "playing"
    },
    {
      "from": "playing",
      "on": "blocks.soft_drop"
    }
  ],
  "tick": [],
  "game": {
    "type": "blocks",
    "tick_ms": 480,
    "playing_state": "playing",
    "result_state": "result",
    "score_var": "score",
    "actions": {
      "start": "blocks.start",
      "left": "blocks.left",
      "right": "blocks.right",
      "rotate": "blocks.rotate",
      "drop": "blocks.drop",
      "soft_drop": "blocks.soft_drop"
    }
  },
  "dashboard": {
    "title": "像素方块",
    "eyebrow": {
      "switch_state": {
        "ready": "准备开始",
        "playing": "自动下落",
        "result": "本轮结束",
        "paused": "休息一下"
      }
    },
    "headline": {
      "switch_state": {
        "ready": "准备好了吗",
        "playing": "保持节奏",
        "result": "再试一次吧",
        "paused": "已暂停"
      }
    },
    "metricLabel": "分数",
    "metricValue": {
      "var": "score"
    },
    "note": {
      "switch_state": {
        "ready": "READY",
        "playing": "PLAY",
        "result": "GAME OVER",
        "paused": "PAUSED"
      }
    },
    "footer": {
      "switch_state": {
        "ready": "SW1开始 · SW2旋转 · 摇杆左右/下 · 全局键退出",
        "playing": "SW2旋转 · 摇杆左右移动/下落 · 全局键退出",
        "result": "SW1重开 · 全局键退出",
        "paused": "暂停中 · 按暂停键继续"
      }
    },
    "visualStyle": "clean",
    "visualPalette": "mono",
    "visualLayout": "arcade",
    "visualSprite": {
      "switch_state": {
        "ready": "blocks",
        "playing": "blocks",
        "result": "trophy",
        "paused": "timer"
      }
    },
    "metricUnit": {
      "switch_state": {
        "ready": "开始游戏",
        "playing": "游戏进行中",
        "result": "重新开始",
        "paused": "继续游戏"
      }
    },
    "badge": {
      "var": "best"
    }
  },
  "surface": {
    "engine": "p4-app-surface-v1",
    "graphics": "p4-app-graphics-v1",
    "background": 8487,
