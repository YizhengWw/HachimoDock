{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
    "score": {
      "type": "int",
      "init": 0
    },
    "best": {
      "type": "int",
      "init": 0
    },
    "charge": {
      "type": "int",
      "init": 0
    },
    "hundred": {
      "type": "int",
      "init": 100
    }
  },
  "states": [
    "ready",
    "playing",
    "paused",
    "result"
  ],
  "initial_state": "ready",
  "transitions": [
    {"from":"*","on":"session.restart","to":"playing","set":{"charge":0}},
    {
      "from": "ready",
      "on": "jump.charge",
      "to": "playing"
    },
    {
      "from": "playing",
      "on": "jump.charge",
      "to": "playing"
    },
    {
      "from": "result",
      "on": "jump.charge",
      "to": "playing"
    },
    {
      "from": "playing",
      "on": "session.pause",
      "to": "paused"
    },
    {
      "from": "paused",
      "on": "session.pause",
      "to": "playing"
    }
  ],
  "tick": [],
  "dashboard": {
    "title": "云端跳一跳",
    "eyebrow": "蓄一点力，向前一点点",
    "headline": {
      "switch_state": {
        "ready": "陪小狗，跳过下一朵云",
        "playing": "松开，出发！",
        "paused": "歇一下，云朵会等你",
        "result": "没关系，再跳一次"
      }
    },
    "metricValue": {
      "var": "score"
    },
    "metricLabel": {
      "switch_state": {
        "ready": "按住开始",
        "playing": "按住蓄力",
        "paused": "已暂停",
        "result": "按住重来"
      }
    },
    "metricUnit": {
      "switch_state": {
        "ready": "暂停",
        "playing": "暂停",
        "paused": "继续",
        "result": "暂停"
      }
    },
    "badge": {
      "var": "best"
    },
    "note": "按住越久，跳得越远",
    "footer": "落上下一座平台得 1 分 · 掉落结束",
    "progress": {
      "pct_of": "charge",
      "of_max": "hundred"
    },
    "visualStyle": "clean",
    "visualPalette": "mint",
    "visualLayout": "scoreboard",
    "visualSprite": "star"
  },
  "input": {
    "engine": "p4-input-v1",
    "hold": "jump.charge",
    "confirm": {"session.restart":"重新开始本局？最高分会保留。"}
  },
  "lifecycle": {
    "pause_action": "session.pause",
    "record_var": "best"
  },
  "persist": {
    "version": 1,
    "vars": [
      "best"
    ],
    "states": {
      "ready": "ready",
      "playing": "ready",
      "paused": "ready",
      "result": "ready"
    }
  },
  "scene": {
    "tick_ms": 20,
    "active_state": "playing",
    "result_state": "result",
    "score_var": "score",
    "grid": {
      "width": 16,
      "height": 8
    },
    "motion": {
      "engine": "p4-motion-v1",
      "body": "puppy",
      "platforms": [
        "home",
        "next",
        "ahead",
        "far"
      ],
      "gravity": 18,
      "lift": 7,
      "speed": [
        2,
        15
      ],
      "charge_ms": 1200,
      "charge_var": "charge",
      "track": {
        "engine": "p4-platform-track-v1",
        "camera_x": 4,
        "gap": [2, 5],
        "width": [2, 4],
        "tones": [1, 2, 3, 4]
      }
    },
    "entities": [
      {
        "id": "puppy",
        "x": 2,
        "y": 4,
        "width": 2,
        "height": 2,
        "tone": 1,
        "shape": "character",
        "bounds": "stop"
      },
      {
        "id": "home",
        "x": 1,
        "y": 6,
        "width": 4,
        "height": 1,
        "tone": 2,
        "shape": "capsule"
      },
      {
        "id": "next",
        "x": 8,
        "y": 6,
        "width": 3,
        "height": 1,
        "tone": 3,
        "shape": "capsule"
      },
      {
        "id": "ahead", "x": 8, "y": 6, "width": 2, "height": 1,
        "tone": 1, "shape": "capsule"
      },
      {
        "id": "far", "x": 12, "y": 6, "width": 3, "height": 1,
        "tone": 4, "shape": "capsule"
      }
    ],
    "rules": [
      {"on":"session.restart","do":[{"op":"restart"}]},
      {
        "on": "jump.charge",
        "do": [
          {
            "op": "charge",
            "entity": "puppy"
          }
        ]
      },
      {
        "on": "landed",
        "entity": "puppy",
        "with": "next",
        "do": [
          {
            "op": "score",
            "add": 1
          }
        ]
      },
      {"on": "landed", "entity": "puppy", "with": "home", "do": [{"op": "score", "add": 1}]},
      {"on": "landed", "entity": "puppy", "with": "ahead", "do": [{"op": "score", "add": 1}]},
      {"on": "landed", "entity": "puppy", "with": "far", "do": [{"op": "score", "add": 1}]},
      {
        "on": "edge",
        "entity": "puppy",
        "edge": "any",
        "do": [
          {
            "op": "stop"
          }
        ]
      }
    ]
  },
  "surface": {
    "engine": "p4-app-surface-v1",
    "graphics": "p4-app-graphics-v1",
    "background": 65501,
    "images": [
      {
        "id": "background",
        "asset": "assets/background.png",
        "frame_width": 640,
        "frame_height": 480,
        "frames": 1,
        "fps": 1,
        "encoding": "jpeg"
      },
      {
        "id": "hero",
        "asset": "assets/hero.png",
        "frame_width": 80,
        "frame_height": 80,
        "frames": 1,
        "fps": 1
      },
      {
        "id": "digits",
        "asset": "assets/digits.png",
        "frame_width": 160,
        "frame_height": 128,
        "frames": 1,
        "fps": 1
      },
      {
        "id": "labels",
        "asset": "assets/labels.png",
        "frame_width": 224,
        "frame_height": 192,
        "frames": 1,
        "fps": 1
      }
    ],
    "scene_view": {
      "engine": "p4-scene-surface-v1",
      "x": 24,
      "y": 138,
      "w": 592,
      "h": 216,
      "colors": [
        45366,
