{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
    "score": {
      "type": "int",
      "init": 0
    },
    "best": {
      "type": "int",
      "init": 0
    }
  },
  "states": [
    "ready",
    "playing",
    "result",
    "paused"
  ],
  "initial_state": "ready",
  "transitions": [
    {
      "from": "ready",
      "on": "flappy.flap",
      "to": "playing"
    },
    {
      "from": "playing",
      "on": "flappy.flap",
      "to": "playing"
    },
    {
      "from": "result",
      "on": "flappy.flap",
      "to": "playing"
    },
    {
      "from": "playing",
      "on": "session.pause",
      "to": "paused"
    },
    {
      "from": "paused",
      "on": "session.pause",
      "to": "playing"
    }
  ],
  "tick": [],
  "game": {
    "type": "flappy",
    "tick_ms": 100,
    "playing_state": "playing",
    "result_state": "result",
    "score_var": "score",
    "actions": {
      "flap": "flappy.flap"
    },
    "vertical_speed_percent": 50
  },
  "dashboard": {
    "title": "像素飞鸟",
    "headline": {
      "switch_state": {
        "ready": "准备好了吗",
        "playing": "飞得轻一点",
        "result": "再试一次吧",
        "paused": "已暂停"
      }
    },
    "metricLabel": "得分",
    "metricValue": {
      "var": "score"
    },
    "footer": {
      "switch_state": {
        "ready": "SW1 拍翅 · 全局键退出",
        "playing": "SW1 拍翅 · 全局键退出",
        "result": "SW1 重开 · 全局键退出",
        "paused": "暂停中 · 按暂停键继续"
      }
    },
    "visualStyle": "clean",
    "visualPalette": "ocean",
    "visualLayout": "arcade",
    "visualSprite": {
      "switch_state": {
        "ready": "flappy",
        "playing": "flappy",
        "result": "trophy",
        "paused": "timer"
      }
    },
    "metricUnit": {
      "switch_state": {
        "ready": "拍翅开始",
        "playing": "轻轻拍翅",
        "result": "重新开始",
        "paused": "先继续游戏"
      }
    },
    "badge": {
      "var": "best"
    }
  },
