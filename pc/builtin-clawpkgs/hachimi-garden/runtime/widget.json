{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
    "duration": {
      "type": "int",
      "init": 1500
    },
    "left": {
      "type": "int",
      "init": 1500
    },
    "flowers": {
      "type": "int",
      "init": 0
    },
    "elapsed": {
      "type": "int",
      "init": 0
    },
    "bloom": {
      "type": "int",
      "init": 2
    }
  },
  "states": [
    "ready",
    "run",
    "paused",
    "done"
  ],
  "initial_state": "ready",
  "transitions": [
    {
      "from": "ready",
      "on": "primary",
      "to": "run",
      "set": {
        "left": {
          "var": "duration"
        },
        "elapsed": 0
      },
      "page": "focus"
    },
    {
      "from": "run",
      "on": "primary",
      "to": "paused"
    },
    {
      "from": "paused",
      "on": "primary",
      "to": "run"
    },
    {
      "from": "done",
      "on": "primary",
      "to": "run",
      "set": {
        "left": {
          "var": "duration"
        },
        "elapsed": 0
      },
      "page": "focus"
    },
    {
      "from": "*",
      "on": "secondary",
      "page": "next"
    },
    {
      "from": "ready",
      "on": "less",
      "inc": {
        "duration": -300
      }
    },
    {
      "from": "ready",
      "on": "more",
      "inc": {
        "duration": 300
      }
    },
    {
      "from": "done",
      "on": "less",
      "to": "ready",
      "inc": {
        "duration": -300
      },
      "set": {
        "elapsed": 0
      }
    },
    {
      "from": "done",
      "on": "more",
      "to": "ready",
      "inc": {
        "duration": 300
      },
      "set": {
        "elapsed": 0
      }
    }
  ],
  "tick": [
    {
      "every_ms": 1000,
      "while_state": "run",
      "inc": {
        "left": -1,
        "elapsed": 1
      },
      "when": {
        "var": "left",
        "lte": 0
      },
      "then": {
        "to": "done",
        "inc": {
          "flowers": 1
        }
      }
    }
  ],
  "dashboard": {
    "title": "专注花园",
    "visualStyle": "clean",
    "visualPalette": "forest",
    "visualLayout": "tool",
    "visualSprite": "star",
    "eyebrow": {
      "switch_page": {
        "focus": "只做眼前这一件事",
        "garden": "花园 · 完成一次长一株"
      }
    },
    "headline": {
      "switch_state": {
        "ready": "准备专注",
        "run": "慢慢生长",
        "paused": "休息一下",
        "done": "又长出一株"
      }
    },
    "metricValue": {
      "switch_state": {
        "ready": {
          "fmt_mmss": "duration"
        },
        "run": {
          "fmt_mmss": "left"
        },
        "paused": {
          "fmt_mmss": "left"
        },
        "done": "完成"
      }
    },
    "badge": {
      "var": "flowers"
    },
    "note": "左右调节 5–60 分钟；完成才计入花园。",
    "footer": "SW1 开始/暂停  SW2 花园  左右调时  全局键退出",
    "metricLabel": {
      "switch_state": {
        "ready": "开始专注",
        "run": "暂停",
        "paused": "继续",
        "done": "再种一株"
      }
    },
    "metricUnit": {
      "switch_page": {
        "focus": "我的花园",
        "garden": "返回专注"
      }
    },
    "progress": {
      "pct_of": "left",
      "of_max": "duration",
      "label": "剩余时间"
    }
  },
  "surface": {
    "engine": "p4-app-surface-v1",
