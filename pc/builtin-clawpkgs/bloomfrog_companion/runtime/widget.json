{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
    "bond": {
      "type": "int",
      "init": 30
    },
    "bond_max": {
      "type": "int",
      "init": 100
    },
    "meals": {
      "type": "int",
      "init": 0
    },
    "pets": {
      "type": "int",
      "init": 0
    },
    "reply": {
      "type": "string",
      "init": "来陪我玩吧！"
    }
  },
  "states": [
    "together"
  ],
  "initial_state": "together",
  "transitions": [
    {
      "on": "move_up",
      "from": "*"
    },
    {
      "on": "move_down",
      "from": "*"
    },
    {
      "on": "move_left",
      "from": "*"
    },
    {
      "on": "move_right",
      "from": "*"
    },
    {
      "on": "pet_pet",
      "from": "*",
      "inc": {
        "bond": 1,
        "pets": 1
      },
      "set": {
        "reply": "舒服～再摸摸！"
      }
    },
    {
      "on": "feed_pet",
      "from": "*",
      "inc": {
        "bond": 2,
        "meals": 1
      },
      "set": {
        "reply": "吃饱啦，谢谢你！"
      }
    }
  ],
  "tick": [],
  "dashboard": {
    "title": "蛙蛙养成",
    "eyebrow": "小小绿意，慢慢相伴",
    "headline": {
      "var": "reply"
    },
    "metricLabel": "亲密度",
    "metricValue": {
      "var": "bond"
    },
    "metricUnit": "芽",
    "note": "抚摸间隔 2 秒，喂食间隔 30 秒；不减少亲密度。",
    "footer": "摇杆移动 · 互动养成 · 全局键退出",
    "progress": {
      "pct_of": "bond",
      "of_max": "bond_max",
      "label": "相伴成长"
    },
    "visualStyle": "clean",
    "visualPalette": "forest",
    "visualLayout": "tool",
    "visualSprite": "star"
  },
  "scene": {
    "tick_ms": 900,
    "active_state": "together",
    "auto_start": true,
    "grid": {
      "width": 16,
      "height": 12
    },
    "entities": [
      {
        "id": "pet",
        "x": 4,
        "y": 2,
        "width": 8,
        "height": 8,
        "tone": 2,
        "bounds": "clamp",
        "collidable": false
      },
      {
        "id": "snack",
        "x": 8,
        "y": 7,
        "shape": "coin",
        "tone": 3,
        "active": false,
        "collidable": false
      },
      {
        "id": "joy",
        "x": 9,
        "y": 3,
        "shape": "heart",
        "tone": 4,
        "active": false,
        "collidable": false
      }
    ],
    "rules": [
      {
        "on": "move_up",
        "do": [
          {
            "op": "move",
            "entity": "pet",
            "dx": 0,
            "dy": -1
          }
        ]
      },
      {
        "on": "move_down",
        "do": [
          {
            "op": "move",
            "entity": "pet",
            "dx": 0,
            "dy": 1
          }
        ]
      },
      {
        "on": "move_left",
        "do": [
          {
            "op": "move",
            "entity": "pet",
            "dx": -1,
            "dy": 0
          }
        ]
      },
      {
        "on": "move_right",
        "do": [
          {
            "op": "move",
            "entity": "pet",
            "dx": 1,
            "dy": 0
          }
        ]
      },
      {
        "on": "pet_pet",
        "do": [
          {
            "op": "place",
            "entity": "joy",
            "source": "pet",
            "dx": 4,
            "dy": 0
          },
          {
            "op": "tone",
            "entity": "pet",
            "tone": 3
          }
        ]
      },
      {
        "on": "feed_pet",
        "do": [
          {
            "op": "place",
            "entity": "snack",
            "source": "pet",
            "dx": 3,
            "dy": 4
          },
          {
            "op": "tone",
            "entity": "pet",
            "tone": 4
          }
        ]
      },
      {
        "on": "tick",
        "do": [
          {
            "op": "hide",
            "entity": "snack"
          },
          {
            "op": "hide",
            "entity": "joy"
          },
          {
            "op": "tone",
            "entity": "pet",
            "tone": 2
          }
        ]
      }
    ]
  },
