{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
    "score": {
      "type": "int",
      "init": 0
    },
    "best": {
      "type": "int",
      "init": 0
    }
  },
  "states": [
    "ready",
    "playing",
    "result",
    "paused"
  ],
  "initial_state": "ready",
  "transitions": [
    {
      "from": "ready",
      "on": "snake.start",
      "to": "playing",
      "set": {
        "score": 0
      }
    },
    {
      "from": "result",
      "on": "snake.start",
      "to": "playing",
      "set": {
        "score": 0
      }
    },
    {
      "from": "playing",
      "on": "snake.turn_left"
    },
    {
      "from": "playing",
      "on": "snake.turn_right"
    },
    {
      "from": "playing",
      "on": "session.pause",
      "to": "paused"
    },
    {
      "from": "paused",
      "on": "session.pause",
      "to": "playing"
    },
    {
      "from": "paused",
      "on": "snake.start",
      "to": "playing"
    },
    {
      "from": "playing",
      "on": "snake.up"
    },
    {
      "from": "playing",
      "on": "snake.down"
    }
  ],
  "tick": [],
  "game": {
    "type": "snake",
    "tick_ms": 220,
    "playing_state": "playing",
    "result_state": "result",
    "score_var": "score",
    "actions": {
      "start": "snake.start",
      "left": "snake.turn_left",
      "right": "snake.turn_right",
      "up": "snake.up",
      "down": "snake.down"
    },
    "direction_mode": "absolute"
  },
  "dashboard": {
    "title": "像素贪吃蛇",
    "eyebrow": {
      "switch_state": {
        "ready": "准备开始",
        "playing": "持续前进",
        "result": "本轮结束",
        "paused": "休息一下"
      }
    },
    "headline": {
      "switch_state": {
        "ready": "准备好了吗",
        "playing": "保持节奏",
        "result": "再试一次吧",
        "paused": "已暂停"
      }
    },
    "metricLabel": "食物",
    "metricValue": {
      "var": "score"
    },
    "note": {
      "switch_state": {
        "ready": "READY",
        "playing": "PLAY",
        "result": "GAME OVER",
        "paused": "PAUSED"
      }
    },
    "footer": {
      "switch_state": {
        "ready": "SW1开始 · 摇杆左右转向 · 全局键退出",
        "playing": "摇杆左右转向 · 全局键退出",
        "result": "SW1重开 · 全局键退出",
        "paused": "暂停中 · 按暂停键继续"
      }
    },
    "visualStyle": "clean",
    "visualPalette": "mint",
    "visualLayout": "arcade",
    "visualSprite": {
      "switch_state": {
        "ready": "snake",
        "playing": "snake",
        "result": "trophy",
        "paused": "timer"
      }
    },
    "metricUnit": {
      "switch_state": {
        "ready": "开始游戏",
        "playing": "游戏进行中",
        "result": "重新开始",
        "paused": "继续游戏"
      }
    },
    "badge": {
      "var": "best"
    }
  },
  "surface": {
    "engine": "p4-app-surface-v1",
