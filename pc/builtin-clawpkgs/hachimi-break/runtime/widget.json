{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
    "left": {
      "type": "int",
      "init": 30
    },
    "rounds": {
      "type": "int",
      "init": 0
    }
  },
  "states": [
    "idle",
    "run",
    "paused",
    "done",
    "later"
  ],
  "initial_state": "idle",
  "transitions": [
    {
      "from": "idle",
      "on": "primary",
      "to": "run",
      "set": {
        "left": 30
      }
    },
    {
      "from": "run",
      "on": "primary",
      "to": "paused"
    },
    {
      "from": "paused",
      "on": "primary",
      "to": "run"
    },
    {
      "from": "done",
      "on": "primary",
      "to": "run",
      "set": {
        "left": 30
      }
    },
    {
      "from": "later",
      "on": "primary",
      "to": "run",
      "set": {
        "left": 30
      }
    },
    {
      "from": "*",
      "on": "secondary",
      "to": "later",
      "set": {
        "left": 300
      }
    },
    {
      "from": "*",
      "on": "previous",
      "page": "prev"
    },
    {
      "from": "*",
      "on": "next",
      "page": "next"
    }
  ],
  "tick": [
    {
      "every_ms": 1000,
      "while_state": "run",
      "inc": {
        "left": -1
      },
      "when": {
        "var": "left",
        "lte": 0
      },
      "then": {
        "to": "done",
        "inc": {
          "rounds": 1
        }
      }
    },
    {
      "every_ms": 1000,
      "while_state": "later",
      "inc": {
        "left": -1
      },
      "when": {
        "var": "left",
        "lte": 0
      },
      "then": {
        "to": "idle",
        "set": {
          "left": 30
        }
      }
    }
  ],
  "dashboard": {
    "title": "活力间歇",
    "visualStyle": "clean",
    "visualPalette": "candy",
    "visualLayout": "tool",
    "visualSprite": "star",
    "eyebrow": {
      "switch_state": {
        "idle": "给自己半分钟",
        "run": "按舒服的节奏",
        "paused": "已暂停",
        "done": "轻休息完成",
        "later": "五分钟后再提醒"
      }
    },
    "headline": {
      "switch_page": {
        "shoulders": "放松肩膀",
        "eyes": "看看远处",
        "hands": "轻松握放"
      }
    },
    "metricValue": {
      "fmt_mmss": "left"
    },
    "note": {
      "switch_page": {
        "shoulders": "轻轻抬肩，再慢慢放下；不适就停止。",
        "eyes": "目光离开屏幕，看看远处；自然眨眼。",
        "hands": "双手轻轻张开、握拢；不适就停止。"
      }
    },
    "footer": "SW1 开始/暂停  SW2 稍后  左右换动作  全局键退出",
    "metricLabel": {
      "switch_state": {
        "idle": "开始休息",
        "run": "暂停",
        "paused": "继续",
        "done": "再来一次",
        "later": "现在开始"
      }
    },
    "metricUnit": "稍后五分钟"
  },
