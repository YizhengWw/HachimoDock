{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
    "remaining_min": {
      "type": "int",
      "init": 60
    },
    "interval_min": {
      "type": "int",
      "init": 60
    },
    "drink_count_today": {
      "type": "int",
      "init": 0
    }
  },
  "states": [
    "counting",
    "paused",
    "due",
    "paused_due"
  ],
  "initial_state": "counting",
  "pages": [
    {
      "id": "countdown"
    },
    {
      "id": "records"
    }
  ],
  "initial_page": "countdown",
  "transitions": [
    {
      "from": "*",
      "on": "reminder.acknowledge",
      "to": "counting",
      "set": {
        "remaining_min": {
          "var": "interval_min"
        }
      },
      "inc": {
        "drink_count_today": 1
      }
    },
    {
      "from": "counting",
      "on": "reminder.pause_resume",
      "to": "paused"
    },
    {
      "from": "due",
      "on": "reminder.pause_resume",
      "to": "paused_due"
    },
    {
      "from": "paused",
      "on": "reminder.pause_resume",
      "to": "counting"
    },
    {
      "from": "*",
      "on": "reminder.switch_view",
      "page": "next"
    },
    {
      "from": "paused_due",
      "on": "reminder.pause_resume",
      "to": "due"
    },
    {
      "from": "*",
      "on": "reminder.switch_previous",
      "page": "prev"
    },
    {
      "from": "*",
      "on": "reminder.less",
      "inc": {
        "interval_min": -15
      }
    },
    {
      "from": "*",
      "on": "reminder.more",
      "inc": {
        "interval_min": 15
      }
    }
  ],
  "tick": [
    {
      "every_ms": 60000,
      "while_state": "counting",
      "inc": {
        "remaining_min": -1
      },
      "when": {
        "var": "remaining_min",
        "lte": 0
      },
      "then": {
        "to": "due",
        "set": {
          "remaining_min": 0
        }
      }
    }
  ],
  "dashboard": {
    "title": "喝水提醒",
    "eyebrow": {
      "switch_page": {
        "countdown": "给自己一个喝水的间隙",
        "records": "每一次确认，都算数"
      }
    },
    "headline": {
      "switch_state": {
        "counting": "慢慢喝，不必等口渴。",
        "paused": "先忙吧，提醒已暂停。",
        "due": "休息一下，喝口水吧。",
        "paused_due": "喝水提醒已暂存。"
      }
    },
    "metricLabel": {
      "switch_page": {
        "countdown": "距离下次提醒",
        "records": "累计确认次数"
      }
    },
    "metricValue": {
      "switch_page": {
        "countdown": {
          "var": "remaining_min"
        },
        "records": {
          "var": "drink_count_today"
        }
      }
    },
    "metricUnit": {
      "switch_state": {
        "counting": "暂停提醒",
        "paused": "继续提醒",
        "due": "暂停提醒",
        "paused_due": "恢复提醒"
      }
    },
    "badge": {
      "var": "drink_count_today"
    },
    "note": {
      "switch_page": {
        "countdown": "间隔调整在下次确认喝水后生效。",
        "records": "累计确认次数，不会按自然日清零。"
      }
    },
    "footer": "主键记录  副键暂停/恢复  摇杆右切换  全局键退出",
    "progress": {
      "pct_of": "remaining_min",
      "of_max": "interval_min",
      "label": "距提醒"
    },
    "visualStyle": "clean",
    "visualPalette": "ocean",
    "visualLayout": "tool",
    "visualSprite": {
      "switch_state": {
        "counting": "droplet",
        "paused": "timer",
        "due": "droplet",
        "paused_due": "timer"
      }
    }
  },
