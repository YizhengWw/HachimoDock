{
 "schemaVersion": 1,
 "profile": "p4-samples-v1",
 "notes": "Shared p4-samples-v1 vectors. Files: assets/<id>.wav compiled by the PC to runtime/samples/<id>.pcm (P4A1, 16 kHz mono s16le, <= 64 KiB each, 256 KiB per package). Validators check declarations here; file checks are separate.",
 "limits": {
  "items": 4,
  "sampleBytes": 65536,
  "budgetBytes": 262144,
  "voices": 2
 },
 "vectors": [
  {
   "name": "two samples with transition and tick ops",
   "ok": true,
   "runtime": {
    "engine": "p4-bounded-runtime-v4",
    "states": [
     "idle"
    ],
    "initial_state": "idle",
    "vars": {
     "n": {
      "type": "int",
      "init": 0
     }
    },
    "transitions": [
     {
      "from": "*",
      "on": "pet",
      "sample": "ding"
     }
    ],
    "tick": [
     {
      "every_ms": 1000,
      "inc": {
       "n": 1
      },
      "when": {
       "var": "n",
       "lte": 0
      },
      "then": {
       "set": {
        "n": 3
       },
       "sample": "pop"
      }
     }
    ],
    "samples": {
     "engine": "p4-samples-v1",
     "volume": 80,
     "items": [
      {
       "id": "ding",
       "asset": "assets/ding.wav"
      },
      {
       "id": "pop",
       "asset": "assets/pop.wav"
      }
     ]
    }
   }
  },
