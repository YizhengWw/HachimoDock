{
 "schemaVersion": 1,
 "profile": "p4-events-v1",
 "notes": "Shared p4-events-v1 vectors: emit names (<= 8, <= 15 safe ASCII), event:<name> transition triggers (<= 8 subscriptions), and alarms (<= 4, every_ms >= 60000 or at_ms_var, action must be a declared transition trigger, background bubbles need the PC alarm policy). Alarms need events and persist.",
 "limits": {
  "names": 8,
  "queue": 8,
  "nameLength": 15,
  "alarms": 4,
  "alarmMinMs": 60000,
  "textBytes": 40
 },
 "vectors": [
  {
   "name": "emit and subscribe",
   "ok": true,
   "runtime": {
    "engine": "p4-bounded-runtime-v4",
    "states": [
     "idle"
    ],
    "initial_state": "idle",
    "vars": {},
    "transitions": [
     {
      "from": "*",
      "on": "pet",
      "emit": "done"
     },
     {
      "from": "*",
      "on": "event:done",
      "to": "idle"
     },
     {
      "from": "*",
      "on": "event:ping"
     }
    ],
    "tick": [],
    "events": {
     "engine": "p4-events-v1",
     "emit": [
      "done",
      "ping"
     ]
    }
   }
  },
