   "won",
   "draw"
  ],
  "initial_state": "play",
  "transitions": [
   {
    "from": "play",
    "on": "move.left",
    "inc": {
     "cx": -1
    }
   },
   {
    "from": "play",
    "on": "move.right",
    "inc": {
     "cx": 1
    }
   },
   {
    "from": "play",
    "on": "move.up",
    "inc": {
     "cy": -1
    }
   },
   {
    "from": "play",
    "on": "move.down",
    "inc": {
     "cy": 1
    }
   },
   {
    "from": "play",
    "on": "place",
    "when": {
     "cell": {
      "x": {
       "var": "cx"
      },
      "y": {
       "var": "cy"
      }
     },
     "op": "eq",
     "value": 0
    },
    "set": {
     "turn": {
      "var": "next"
     },
     "next": {
      "var": "turn"
     }
    },
    "cells": [
     {
      "op": "cell",
      "x": {
       "var": "cx"
      },
      "y": {
       "var": "cy"
      },
      "set": {
       "var": "next"
      }
     },
     {
      "op": "cellrun",
      "x": {
       "var": "cx"
      },
      "y": {
       "var": "cy"
      },
      "value": {
       "var": "next"
      },
      "var": "run"
     },
     {
      "op": "cellcount",
      "value": 0,
      "var": "empty"
     }
    ]
   },
   {
    "from": "*",
    "on": "reset",
    "to": "play",
    "set": {
     "turn": 1,
     "next": 2,
     "cx": 1,
     "cy": 1
    },
    "cells": [
     {
      "op": "cellfill",
      "set": 0
     },
     {
      "op": "cellcount",
      "value": 0,
      "var": "empty"
     },
     {
      "op": "cellrun",
      "x": 1,
      "y": 1,
      "value": 1,
      "var": "run"
     }
    ]
   },
   {
    "from": "play",
    "on": "corner",
    "when": {
     "cell": {
      "x": 0,
      "y": 0
     },
     "op": "ne",
     "value": 0
    },
    "set": {
     "run": 3
    },
    "else": {
     "cells": [
      {
       "op": "cell",
       "x": 0,
       "y": 0,
       "set": 3
      }
     ]
    }
   }
  ],
  "tick": [
   {
    "every_ms": 100,
    "while_state": "play",
    "when": {
     "var": "run",
     "op": "gte",
     "value": 3
    },
    "then": {
     "to": "won"
    }
   },
   {
    "every_ms": 100,
    "while_state": "play",
    "when": {
     "all": [
      {
       "var": "empty",
       "op": "eq",
       "value": 0
      },
      {
       "var": "run",
       "op": "lt",
       "value": 3
      }
     ]
    },
    "then": {
     "to": "draw"
    }
   }
  ],
