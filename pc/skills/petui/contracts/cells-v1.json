{
 "schemaVersion": 1,
 "profile": "p4-cells-v1",
 "notes": "Shared p4-cells-v1 vectors. runtime: a complete valid package every validator (Python, Rust, firmware parser, JS preview) accepts. reject: JSON-pointer patches every validator must refuse. cases: semantic runs executed by the JS preview, the packaged mirror and the Python model (expected cells are row strings of hex digits). core: pure grid vectors for the C core (pet_p4_cells.c) and its JS/Python mirrors. Ordering: to/page, then set/inc (sources read the pre-effect snapshot), limits, then cells ops in order reading the current variables; count/run outputs are clamped by limits. Out-of-range reads are -1, out-of-range writes are no-ops, stored values clamp to 0..2^bits-1.",
 "limits": {
  "maxSide": 16,
  "maxCells": 256,
  "bits": [
   2,
   4
  ],
  "maxOpsPerBranch": 4,
  "outOfRangeRead": -1
 },
 "runtime": {
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "logic": "p4-logic-v1",
  "input": {
