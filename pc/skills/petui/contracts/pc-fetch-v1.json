{
 "engine": "pc-fetch-v1",
 "capability": "widgetPcFetch",
 "runtimeVars": {
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "host": true,
  "vars": {
   "price": {
    "type": "string",
    "init": ""
   },
   "change": {
    "type": "int",
    "init": 0
   },
   "name": {
    "type": "string",
    "init": "等待数据"
   }
  },
  "states": [
   "ready"
  ],
  "initial_state": "ready",
  "transitions": [
   {
    "from": "*",
    "on": "host.refresh"
   }
  ],
  "tick": [],
  "input": {
   "engine": "p4-input-v1"
  },
  "dashboard": {
   "title": "Quote",
   "footer": "PC 轮询",
   "visualStyle": "clean",
   "visualPalette": "mono",
   "visualLayout": "tool",
   "visualSprite": "gauge"
  },
  "surface": {
   "engine": "p4-app-surface-v1",
   "graphics": "p4-app-graphics-v1",
   "bindings": "p4-variable-bindings-v1",
   "background": 0,
   "elements": [
    {
     "type": "text",
     "x": 20,
     "y": 20,
     "w": 300,
     "h": 32,
     "color": 65535,
     "var_bind": "name"
    },
    {
     "type": "text",
     "x": 20,
     "y": 60,
     "w": 300,
     "h": 48,
     "color": 65535,
     "font_size": 32,
     "line_height": 40,
     "var_bind": "price"
    },
    {
     "type": "meter",
     "x": 20,
     "y": 120,
     "w": 300,
     "h": 12,
     "color": 65535,
     "var_bind": "change"
    },
    {
     "type": "button",
     "x": 20,
     "y": 160,
     "w": 200,
     "h": 48,
     "color": 65535,
     "foreground": 0,
     "text": "刷新",
     "action": "host.refresh"
    }
   ]
  }
 },
 "applicationVars": {
  "schemaVersion": 1,
  "engine": "pc-fetch-v1",
  "service": "fetch",
  "actions": {
   "host.refresh": "quote:refresh"
  },
  "content": [
   {
    "id": "quote",
    "url": "https://api.example.com/v1/quote?symbol=ABC",
    "method": "GET",
    "headers": {
     "Accept": "application/json"
    },
    "interval_sec": 60,
    "ttl_sec": 300,
    "max_bytes": 16384,
    "map": {
     "vars": {
      "price": "/data/price",
      "change": "/data/change_pct",
      "name": "/data/name"
     }
    }
   }
  ]
 },
 "runtimeRows": {
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "vars": {
   "page": {
    "type": "int",
    "init": 0
   }
  },
  "states": [
   "ready"
  ],
  "initial_state": "ready",
  "data": {
   "source": "fetch.news",
   "page_var": "page"
  },
  "transitions": [
   {
    "from": "*",
    "on": "next",
    "inc": {
     "page": 1
    }
   },
   {
    "from": "*",
    "on": "prev",
    "inc": {
     "page": -1
    }
   }
  ],
  "tick": [],
  "dashboard": {
   "title": "News",
