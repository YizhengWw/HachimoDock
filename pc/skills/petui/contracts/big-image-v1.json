{
 "schemaVersion": 1,
 "profile": "p4-big-image-v1",
 "notes": "Shared p4-big-image-v1 vectors: surface.big_images (<= 2, PNG up to 1280x960 with ceil(w/240)*ceil(h/240) <= 16 tiles, 1 MiB per package after P4T1 tiling) and image nodes that reference them with two int offset vars. Device draws only the tiles under the node window. Vectors marked firmware=surface are rejected on the device by pet_surface (node structure); the pet_p4_component_ext harness only sees the declaration level.",
 "limits": {
  "images": 2,
  "tiles": 16,
  "tile": 240,
  "maxWidth": 1280,
  "maxHeight": 960,
  "budgetBytes": 1048576
 },
