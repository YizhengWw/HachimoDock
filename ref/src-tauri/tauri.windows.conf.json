      "generated-runtime/ffmpeg.LICENSE": "tools/ffmpeg.LICENSE",
      "generated-runtime/ffmpeg.README": "tools/ffmpeg.README",
      "generated-runtime/ffmpeg.SOURCE.txt": "tools/ffmpeg.SOURCE.txt"
    }
  }
}
