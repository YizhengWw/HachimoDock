{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pet Manager",
  "version": "0.1.24",
  "identifier": "com.petmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pet Manager",
        "width": 1200,
        "height": 760,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://ipc.localhost asset:; connect-src 'self' tauri: ipc: http://ipc.localhost asset: http://127.0.0.1:8181 https://staticimgly.com blob: data:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob: data: mediastream:; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self' data:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/terrier-clips": "terrier-clips",
      "../builtin-clawpkgs": "builtin-clawpkgs",
      "bridge/package.json": "bridge/package.json",
      "bridge/packages/clawd-backend-service/package.json": "bridge/packages/clawd-backend-service/package.json",
      "bridge/packages/clawd-backend-service/src": "bridge/packages/clawd-backend-service/src",
      "bridge/packages/agent-session-bus/package.json": "bridge/packages/agent-session-bus/package.json",
      "bridge/packages/agent-session-bus/src": "bridge/packages/agent-session-bus/src",
      "bridge/agents": "bridge/agents",
      "bridge/hooks": "bridge/hooks",
      "bridge/packages/clawd-backend-service/node_modules": "bridge/packages/clawd-backend-service/node_modules",
      "../../skills/petui": "skills/petui",
      "firmware/esp32-p4/firmware.bin": "firmware/esp32-p4/firmware.bin"
    }
  }
}
